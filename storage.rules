rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Sideload APK only — clients GET this object; writes stay off the client SDK.
    match /releases/GateAuto-release.apk {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
