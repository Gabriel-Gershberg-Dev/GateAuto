rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Sideload APKs — clients GET; writes stay off the client SDK.
    // Production: releases/GateAuto-release.apk
    // Beta:       releases/GateAuto-beta.apk  (do not overwrite production)
    match /releases/{apk} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
