<?xml version="1.0" encoding="utf-8"?>
<!-- Mist glass: translucent cabin wash + top sheen. No hairline teal box. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_cabin" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
    <item
        android:height="34dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/widget_sheen_fade"
                android:startColor="@color/widget_sheen" />
            <corners android:radius="@dimen/widget_radius" />
        </shape>
    </item>
</layer-list>
